<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Dark Mode -->
    <style name="Base.Theme.CampusLostandFound" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand Colors Dark -->
        <item name="colorPrimary">#4DB6AC</item>
        <item name="colorOnPrimary">#003738</item>
        <item name="colorPrimaryContainer">#004D40</item>
        <item name="colorOnPrimaryContainer">#B2DFDB</item>

        <item name="colorSecondary">#FFB74D</item>
        <item name="colorOnSecondary">#4B2C00</item>
        <item name="colorSecondaryContainer">#E65100</item>
        <item name="colorOnSecondaryContainer">#FFE0B2</item>

        <item name="android:colorBackground">@color/window_background_dark</item>
        <item name="colorSurface">@color/surface_card_dark</item>

        <!-- System bar styling -->
        <item name="android:statusBarColor">#002022</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.CampusLostandFound" parent="Base.Theme.CampusLostandFound" />

    <!-- Dark Mode Card Style -->
    <style name="RoundedCardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeColor">@color/surface_card_stroke_dark</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
